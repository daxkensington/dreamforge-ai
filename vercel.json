{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/auto-degrade",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/rate-limit-cleanup",
      "schedule": "0 4 * * *"
