# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_ID=
# Public base URL, used for Stripe redirect URLs (marketplace checkout/seller
# onboarding). Defaults to https://dreamforge.art when unset.
APP_URL=

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────
JWT_SECRET=
# NextAuth session signing secret (≥16 chars). Hard-required in production by
# server/_core/envValidation.ts — the deploy fails to boot without it.
# client/src/lib/auth.ts falls back to NEXTAUTH_SECRET if this is unset; that
# fallback is legacy, set AUTH_SECRET.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# NextAuth provider + transactional email. AUTH_RESEND_KEY takes precedence;
# RESEND_API_KEY is the fallback both auth.ts and uncensoredEmail.ts accept.
AUTH_RESEND_KEY=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=DreamForgeX <noreply@dreamforgex.ai>

# ─── Stripe Payments ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── BTCPay (crypto payments — uncensored tier; Stripe stays SFW-only) ─────
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# Shared secret used to verify BTCPay webhook signatures.
BTCPAY_WEBHOOK_SECRET=

# ─── AI Providers (Free — set these first!) ───────────────────────────────
GROQ_API_KEY=
TOGETHER_API_KEY=
CF_AI_TOKEN=

# ─── AI Providers (Paid) ──────────────────────────────────────────────────
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
# fal.ai — image/video gen fallback, song generation, LoRA training. The fal
# provider auto-activates when this is set.
FAL_API_KEY=
# Opt-in: set "true" to enable Google Imagen image gen (requires GEMINI_API_KEY).
# Off by default — keeps an accidental GCP bill from surprising you.
IMAGEN_ENABLED=false

# ─── RunPod Self-Hosted Models (50-90% cost savings) ──────────────────────
# Get API key: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=
# Create endpoint: https://www.runpod.io/console/serverless — use dreamforge-worker Docker image
RUNPOD_FLUX_ENDPOINT_ID=
# Optional dedicated endpoint (bigger GPU) for Wan video. Falls back to the
# flux endpoint above if unset, so a single-endpoint deploy still works.
RUNPOD_VIDEO_ENDPOINT_ID=

# Optional uncensored style LoRAs (HF repo or repo::weight.safetensors).
# Realistic/cinematic/analog default to hugovntr/flux-schnell-realism if unset.
# UNCENSORED_LORA_REALISTIC=hugovntr/flux-schnell-realism::schnell-realism_v2.3.safetensors
# UNCENSORED_LORA_ANIME=
# UNCENSORED_LORA_DEFAULT=

# ─── Video Providers ──────────────────────────────────────────────────────
RUNWAY_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Opt-in: set "true" to enable Google Veo 3 video gen (requires GEMINI_API_KEY).
# Gated because it's expensive per generation.
VEO3_ENABLED=false

# ─── Sync Labs (Lip Sync) ─────────────────────────────────────────────────
SYNC_LABS_API_KEY=

# ─── Built-in Forge (data/map proxy) ──────────────────────────────────────
# Proxy base URL + bearer key for Google Maps, third-party data APIs
# (server/_core/map.ts, dataApi.ts) and voice transcription.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Vercel Cron ───────────────────────────────────────────────────────────
# Vercel Cron invokes /api/cron/* with "Authorization: Bearer <CRON_SECRET>".
# Required in production — the cron routes fail closed (403) when it's missing
# there; in dev an unset secret just means no auth check.
CRON_SECRET=

# ─── Sentry (error monitoring) ─────────────────────────────────────────────
# Server/edge DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=
# Browser DSN (instrumentation-client.ts, sentry.client.config.ts). Events go
# through the same-origin /monitoring tunnel (next.config.ts tunnelRoute).
NEXT_PUBLIC_SENTRY_DSN=

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dreamforge-assets
R2_PUBLIC_URL=

# ─── Legacy (can be removed if not using Manus OAuth) ──────────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
NEXT_PUBLIC_META_PIXEL_ID=
